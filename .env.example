# Copy this file to .env and fill in your real Neon connection string.
#   cp .env.example .env
#
# Neon dashboard -> your project -> "Connection string" -> Node.js / psql.
# It looks like:
#   postgresql://<user>:<password>@ep-xxxx-xxxx.<region>.aws.neon.tech/<db>?sslmode=require
#
# .env is git-ignored. .env.example is committed, so never put real secrets here.
DATABASE_URL=

# Port the Express server listens on.
PORT=3000
